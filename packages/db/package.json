{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./index.ts",
    "./testing": "./testing.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "db:generate": "bun --bun run prisma generate",
    "db:migrate": "bun --bun run prisma migrate deploy",
    "db:reset-workflow-demo": "bun scripts/reset-workflow-demo.ts",
    "db:setup-access": "bun scripts/setup-access.ts",
    "db:setup-access:local": "bun scripts/setup-access.ts --create-local-credentials",
    "test": "bun test tests",
    "test:access": "bun test tests/permissions.test.ts tests/invariants.test.ts",
    "test:access:hosted": "bun test tests/permissions.test.ts tests/hosted-invariants.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/bun": "latest",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@repo/config": "*",
    "@repo/schemas": "*",
    "dotenv": "^17.4.2",
    "pg": "^8.16.3"
  }
}
