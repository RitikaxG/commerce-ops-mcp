{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "db:generate": "bun --bun run prisma generate",
    "db:migrate": "bun --bun run prisma migrate deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/bun": "latest",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@repo/config": "*",
    "@repo/schemas": "*",
    "dotenv": "^17.4.2",
    "pg": "^8.16.3"
  }
}
