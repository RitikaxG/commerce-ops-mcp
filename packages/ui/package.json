{
  "name": "@repo/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./styles.css",
    "./*": "./components/*.tsx"
  },
  "license": "MIT",
  "scripts": {
    "build": "bun run build:styles && bun run build:components",
    "build:styles": "tailwindcss -i ./styles.css -o ./dist/styles.css",
    "build:components": "tsc",
    "typecheck": "tsc --noEmit",
    "check-types": "bun run typecheck",
    "dev:styles": "tailwindcss -i ./styles.css -o ./dist/styles.css --watch",
    "dev:components": "tsc --watch",
    "lint": "eslint components --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/tailwind-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/cli": "^4.1.5",
    "@types/react": "^19.1.0",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.1.5",
    "typescript": "5.9.2"
  }
}
