NODE_ENV=development
PORT=3000

# Comma-separated Host-header allowlist for /mcp. Production requires an
# explicit non-wildcard value; local development defaults to loopback hosts.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Protects only /mcp with Authorization: Bearer <key>. Production requires a
# random value of at least 32 characters. Generate one without sharing it:
# openssl rand -base64 48
MCP_API_KEY=

# Schema-owner/migration connection. Never load this from runtime application code.
DATABASE_URL=

# Explicit commerce seed/reset connection. Use only for one-off setup.
DEMO_DATABASE_URL=

# Restricted workflow runtime connection used by the hosted API.
WORKFLOW_DATABASE_URL=

# Server-side Gemini AI-host configuration. Never expose MODEL_API_KEY to a browser
# or place it on the EC2-hosted MCP server.
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.6-flash
MODEL_API_KEY=
MCP_SERVER_URL=http://127.0.0.1:3000/mcp

# Client-side copy of MCP_API_KEY used by hosted verifiers and the AI host.
MCP_AUTH_BEARER_TOKEN=

AGENT_MAX_TOOL_STEPS=4
AGENT_PROVIDER_TIMEOUT_MS=30000
AGENT_MCP_TIMEOUT_MS=15000

# Gemini requests are serialized and paced. The default 3500 ms interval keeps
# the live evaluator below a 20 requests-per-minute free-tier limit.
AGENT_PROVIDER_MIN_INTERVAL_MS=3500

# Number of retries after the first request for transient 429, timeout, or 5xx failures.
# Daily/project quota exhaustion is never retried.
AGENT_PROVIDER_MAX_RETRIES=2

# Maximum advertised retry delay the process will wait before returning RATE_LIMITED.
AGENT_PROVIDER_MAX_RETRY_DELAY_MS=60000
