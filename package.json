{
  "name": "commerce-operation-workflow",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.2",
  "scripts": {
    "agent:ask": "bun run --filter @repo/agent agent:ask",
    "agent:model-smoke": "bun run --filter @repo/agent agent:model-smoke",
    "build": "turbo run build",
    "db:generate": "bun run --filter @repo/db db:generate",
    "db:migrate": "bun run --filter @repo/db db:migrate",
    "db:reset-demo": "bun run db:reset-workflow-demo && bun run --filter @repo/fixtures reset",
    "db:reset-workflow-demo": "bun run --filter @repo/db db:reset-workflow-demo",
    "db:seed": "bun run --filter @repo/fixtures seed",
    "db:setup-access": "bun run --filter @repo/db db:setup-access",
    "db:setup-access:local": "bun run --filter @repo/db db:setup-access:local",
    "db:verify-access": "bun run --filter @repo/db test:access",
    "db:verify-demo": "bun run --filter @repo/fixtures verify",
    "dev": "turbo run dev",
    "eval:agent:gemini": "bun run --filter @repo/evaluations eval:agent:gemini",
    "eval:mcp:direct": "bun run --filter @repo/evaluations eval:mcp:direct",
    "verify:hosted:ai": "bun run --filter @repo/evaluations verify:hosted:ai",
    "verify:hosted:mcp": "bun run --filter @repo/evaluations verify:hosted:mcp",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check-types": "bun run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.10.7"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
